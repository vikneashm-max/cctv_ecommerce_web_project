# Copy to frontend/.env.local for local overrides (optional in dev — Vite proxy is used by default).
# For production builds, set VITE_API_URL to your deployed backend URL (without /api suffix).

VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_CLIENT_PHONE=+91 80120 00888
